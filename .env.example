# Copy to .env and fill in. Only a subset is read by ezra_core today (see config.py);
# the rest are documented here for upcoming build sessions (per HANDOFF.md).

# LLM
EZRA_LLM_MODEL=gemini/gemini-2.5-flash
EZRA_LLM_API_KEY=
EZRA_META_AGENT_MODEL=gemini/gemini-3.1-flash-lite

# MongoDB (Atlas — cold tier + session graph store)
EZRA_MONGODB_URI=
EZRA_MONGODB_DB=ezra
EZRA_MONGODB_MCP_URL=http://localhost:3001

# Hot / Warm tiers (local Docker in dev; managed on GKE)
EZRA_REDIS_URL=redis://localhost:6379
EZRA_QDRANT_URL=http://localhost:6333

# Token budget / memory behaviour
EZRA_CONTEXT_LIMIT=128000
EZRA_HOT_MAX_TURNS=8
EZRA_SALIENCE_DECAY_RATE=0.1

# Reconciler
EZRA_DEFAULT_MERGE_STRATEGY=last_write_wins
EZRA_MANUAL_RESOLUTION_TIMEOUT_SECONDS=30

# Contradiction detection (NLI) — Session 3
EZRA_NLI_MODEL=cross-encoder/nli-deberta-v3-base
EZRA_NLI_DEVICE=auto
EZRA_EMBEDDING_SIMILARITY_THRESHOLD=0.85
EZRA_NLI_CONFIDENCE_THRESHOLD=0.7

# Meta-agents
EZRA_META_AGENT_LEARNING_ENABLED=true
EZRA_META_AGENT_LIFECYCLE_ENABLED=true
EZRA_CORE_PROMOTION_ACCESS_COUNT=3

# Lifecycle
EZRA_DEFAULT_ARCHIVAL_THRESHOLD_DAYS=90
EZRA_DEFAULT_BELIEF_RETENTION_DAYS=

# Policy
EZRA_POLICY_ENGINE_ENABLED=true

# REST API
EZRA_API_HOST=0.0.0.0
EZRA_API_PORT=8080
EZRA_API_BEARER_TOKEN=dev-token-change-me

# Observability
EZRA_TRACING_ENABLED=false
EZRA_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# GCP / deployment (used by deploy/ tooling, not by ezra_core at runtime).
# Auth is keyless (Workload Identity Federation) — no service-account JSON keys.
EZRA_GCP_PROJECT_ID=ezra-498021
EZRA_GCP_PROJECT_NUMBER=554390343398
EZRA_GCP_REGION=us-east1
EZRA_GCP_ZONE=us-east1-c
EZRA_GCP_AR_REPO=ezra
EZRA_GKE_CLUSTER=ezra
